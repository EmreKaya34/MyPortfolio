@model List<Contact>
@{
    ViewData["Title"] = "İletişim Bilgileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel("İletişim Bilgileri", "Sitedeki iletişim bölümünde ilk kayıt gösterilir.", "Yeni İletişim Bilgisi", "CreateContact"))

    <div class="data-table-card">
        <div class="table-filter-bar">
            <div class="filters-left-group">
                <div class="filter-search-box"><i class="bi bi-search"></i><input type="text" data-table-filter="#dataTable" placeholder="İletişim bilgisi ara..."></div>
            </div>
        </div>
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table js-filter-table" id="dataTable">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Başlık</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th>Lokasyon</th>
                        <th style="text-align: right; width: 170px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.ContactId</td>
                            <td><span class="exp-title-text">@item.Title</span></td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.Location</td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <a class="btn-action-icon btn-edit" title="Güncelle" asp-action="UpdateContact" asp-route-id="@item.ContactId"><i class="bi bi-pencil-square"></i></a>
                                    <button type="button" class="btn-action-icon btn-delete js-delete" title="Sil" data-name="@item.Title"
                                            data-url="@Url.Action("DeleteContact", "Contact", new { area = "Admin", id = item.ContactId })"><i class="bi bi-trash3"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr class="empty-row"><td colspan="6">Henüz iletişim bilgisi eklenmemiş.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>
