@model List<HeroTitle>
@{
    ViewData["Title"] = "Dönen Unvanlar";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel("Dönen Unvanlar", "Aktif unvanlar ana sayfadaki daktilo animasyonunda sırayla gösterilir.", "Yeni Unvan Ekle", "CreateHeroTitle"))

    <div class="data-table-card">
        <div class="table-filter-bar">
            <div class="filters-left-group">
                <div class="filter-search-box"><i class="bi bi-search"></i><input type="text" data-table-filter="#dataTable" placeholder="Unvan ara..."></div>
            </div>
        </div>
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table js-filter-table" id="dataTable">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Unvan</th>
                        <th>Sıra</th>
                        <th>Durum</th>
                        <th style="text-align: right; width: 170px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.HeroTitleId</td>
                            <td><div class="experience-title-cell"><div class="exp-icon-bullet"><i class="bi bi-type"></i></div><span class="exp-title-text">@item.Title</span></div></td>
                            <td><span class="order-badge">@item.Order</span></td>
                            <td>@await Html.PartialAsync("_StatusPill", item.IsActive)</td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <a class="btn-action-icon btn-edit" title="Güncelle" asp-action="UpdateHeroTitle" asp-route-id="@item.HeroTitleId"><i class="bi bi-pencil-square"></i></a>
                                    <button type="button" class="btn-action-icon btn-delete js-delete" title="Sil" data-name="@item.Title"
                                            data-url="@Url.Action("DeleteHeroTitle", "HeroTitle", new { area = "Admin", id = item.HeroTitleId })"><i class="bi bi-trash3"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr class="empty-row"><td colspan="5">Henüz unvan eklenmemiş. Sitede yalnızca Hakkımda ekranındaki unvan gösterilir.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>
