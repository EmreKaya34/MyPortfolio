@model PageHeaderModel

<div class="content-header-row">
    <div>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-subtitle">@Model.Subtitle</p>
    </div>
    @if (!string.IsNullOrEmpty(Model.ButtonAction))
    {
        <div class="header-actions">
            <a asp-action="@Model.ButtonAction" class="btn-pastel-primary text-decoration-none">
                <i class="bi bi-plus-circle-fill"></i>
                <span>@Model.ButtonText</span>
            </a>
        </div>
    }
</div>
