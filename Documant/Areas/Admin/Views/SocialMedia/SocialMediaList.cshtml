@model List<SocialMedia>
@{
    ViewData["Title"] = "Sosyal Medya";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel("Sosyal Medya", "Aktif bağlantılar sitede ana sayfa, iletişim ve footer bölümlerinde görünür.", "Yeni Bağlantı Ekle", "CreateSocialMedia"))

    <div class="data-table-card">
        <div class="table-filter-bar">
            <div class="filters-left-group">
                <div class="filter-search-box"><i class="bi bi-search"></i><input type="text" data-table-filter="#dataTable" placeholder="Platform ara..."></div>
            </div>
        </div>
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table js-filter-table" id="dataTable">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Platform</th>
                        <th>Bağlantı</th>
                        <th>Durum</th>
                        <th style="text-align: right; width: 170px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.SocialMediaId</td>
                            <td><div class="experience-title-cell"><div class="exp-icon-bullet"><i class="@item.IconClass"></i></div><span class="exp-title-text">@item.Name</span></div></td>
                            <td><a href="@item.Url" target="_blank" rel="noopener noreferrer" class="small">@item.Url</a></td>
                            <td>@await Html.PartialAsync("_StatusPill", item.IsActive)</td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <a class="btn-action-icon btn-edit" title="Güncelle" asp-action="UpdateSocialMedia" asp-route-id="@item.SocialMediaId"><i class="bi bi-pencil-square"></i></a>
                                    <button type="button" class="btn-action-icon btn-delete js-delete" title="Sil" data-name="@item.Name"
                                            data-url="@Url.Action("DeleteSocialMedia", "SocialMedia", new { area = "Admin", id = item.SocialMediaId })"><i class="bi bi-trash3"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr class="empty-row"><td colspan="5">Henüz sosyal medya bağlantısı eklenmemiş.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>
