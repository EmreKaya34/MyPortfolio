@model List<Project>
@{
    ViewData["Title"] = "Projelerim";
    string sort = ViewBag.Sort;
    bool isFiltered = ViewBag.IsFiltered;
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel("Projelerim", "Pasif projeler burada görünür ancak sitede listelenmez.", "Yeni Proje Ekle", "CreateProject"))

    <div class="stats-row">
        <div class="stat-card"><div class="stat-icon-wrapper icon-green"><i class="bi bi-code-slash"></i></div><div class="stat-content"><span class="stat-label">Toplam Proje</span><h3 class="stat-value">@Model.Count</h3></div></div>
        <div class="stat-card"><div class="stat-icon-wrapper icon-blue"><i class="bi bi-eye"></i></div><div class="stat-content"><span class="stat-label">Sitede Görünen</span><h3 class="stat-value">@Model.Count(x => x.IsActive)</h3></div></div>
        <div class="stat-card"><div class="stat-icon-wrapper icon-beige"><i class="bi bi-eye-slash"></i></div><div class="stat-content"><span class="stat-label">Pasif</span><h3 class="stat-value">@Model.Count(x => !x.IsActive)</h3></div></div>
    </div>

    <div class="data-table-card">
        <div class="table-filter-bar">
            <div class="filters-left-group">
                <div class="filter-search-box"><i class="bi bi-search"></i><input type="text" data-table-filter="#dataTable" placeholder="Proje, kategori veya teknolojiye göre ara..."></div>
            </div>
            <form method="get" asp-action="ProjectList" class="filter-form" style="width: auto;">
                <select name="categoryId" asp-items="(SelectList)ViewBag.Categories" class="filter-select" aria-label="Kategoriye göre filtrele" onchange="this.form.submit()">
                    <option value="">Tüm kategoriler</option>
                </select>
                <select name="sort" class="filter-select" aria-label="Sırala" onchange="this.form.submit()">
                    <option value="newest" selected="@(sort == "newest")">En yeni</option>
                    <option value="oldest" selected="@(sort == "oldest")">En eski</option>
                    <option value="title" selected="@(sort == "title")">Ada göre (A-Z)</option>
                </select>
            </form>
        </div>
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table js-filter-table" id="dataTable">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Görsel</th>
                        <th>Proje Adı</th>
                        <th>Kategori</th>
                        <th>Teknolojiler</th>
                        <th>Eklenme</th>
                        <th>Durum</th>
                        <th style="text-align: right; width: 170px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.ProjectId</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="table-thumb" alt="@item.ProjectTitle" />
                                }
                                else
                                {
                                    <div class="table-thumb d-flex align-items-center justify-content-center text-muted"><i class="bi bi-image"></i></div>
                                }
                            </td>
                            <td><span class="exp-title-text">@item.ProjectTitle</span></td>
                            <td><span class="work-type-badge">@item.Category?.CategoryName</span></td>
                            <td class="text-muted small">@item.Technologies</td>
                            <td><span class="date-badge"><i class="bi bi-calendar2"></i> @item.CreatedDate.ToString("dd.MM.yyyy")</span></td>
                            <td>@await Html.PartialAsync("_StatusPill", item.IsActive)</td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <button type="button" class="btn-action-icon btn-view js-post" title="@(item.IsActive ? "Pasif yap" : "Aktif yap")"
                                            data-url="@Url.Action("ToggleProjectStatus", "Project", new { area = "Admin", id = item.ProjectId })"><i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i></button>
                                    <a class="btn-action-icon btn-edit" title="Güncelle" asp-action="UpdateProject" asp-route-id="@item.ProjectId"><i class="bi bi-pencil-square"></i></a>
                                    <button type="button" class="btn-action-icon btn-delete js-delete" title="Sil" data-name="@item.ProjectTitle"
                                            data-url="@Url.Action("DeleteProject", "Project", new { area = "Admin", id = item.ProjectId })"><i class="bi bi-trash3"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr class="empty-row"><td colspan="8">@(isFiltered ? "Bu kategoride proje yok." : "Henüz proje eklenmemiş.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>
