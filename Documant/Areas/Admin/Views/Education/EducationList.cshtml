@model List<Education>
@{
    ViewData["Title"] = "Eğitim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel("Eğitim", "Eğitim geçmişiniz sitedeki Eğitim bölümünde sıra numarasına göre görünür.", "Yeni Eğitim Ekle", "CreateEducation"))

    <div class="data-table-card">
        <div class="table-filter-bar">
            <div class="filters-left-group">
                <div class="filter-search-box"><i class="bi bi-search"></i><input type="text" data-table-filter="#dataTable" placeholder="Bölüm veya okula göre ara..."></div>
            </div>
        </div>
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table js-filter-table" id="dataTable">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Bölüm / Derece</th>
                        <th>Okul</th>
                        <th>Rozet</th>
                        <th style="text-align: center;">Sıra</th>
                        <th style="text-align: right; width: 170px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.EducationId</td>
                            <td><span class="exp-title-text">@item.Title</span></td>
                            <td>@item.SchoolName</td>
                            <td><span class="work-type-badge">@item.Badge</span></td>
                            <td style="text-align: center;"><span class="order-badge">@item.DisplayOrder</span></td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <a class="btn-action-icon btn-edit" title="Güncelle" asp-action="UpdateEducation" asp-route-id="@item.EducationId"><i class="bi bi-pencil-square"></i></a>
                                    <button type="button" class="btn-action-icon btn-delete js-delete" title="Sil" data-name="@item.Title"
                                            data-url="@Url.Action("DeleteEducation", "Education", new { area = "Admin", id = item.EducationId })"><i class="bi bi-trash3"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr class="empty-row"><td colspan="6">Henüz eğitim kaydı eklenmemiş.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>
