@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="text-center py-5">
    <h1 class="h3">Bir sorun oluştu</h1>
    <p class="text-muted">İsteğiniz işlenirken beklenmeyen bir hata oluştu. Lütfen daha sonra tekrar deneyin.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">İstek No: <code>@Model.RequestId</code></p>
    }
    <a href="/" class="btn btn-secondary">Ana sayfaya dön</a>
</div>
