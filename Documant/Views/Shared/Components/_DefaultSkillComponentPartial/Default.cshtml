@model List<Documant.Entities.Skill>
<!-- 6. Skills Section -->
<section id="skills">
    <div class="container">
        <div class="section-header text-center mx-auto reveal-on-scroll" style="max-width: 680px;">
            <div class="eyebrow-badge"><i class="bi bi-stack"></i> TEKNOLOJİ YIĞINIM</div>
            <h2 class="section-title">Kullandığım Teknolojiler ve Uzmanlık Alanlarım</h2>
            <p class="section-description mx-auto">
                Bir fikrin hayata geçirilmesinden ölçeklenebilir bir yazılım ürününe dönüşmesine kadar farklı teknolojilerle çalışıyorum.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var skill in Model)
            {
                <div class="col-md-6 col-lg-4 reveal-on-scroll">
                    <div class="skill-card">
                        <div class="skill-icon-box"><i class="@skill.IconUrl"></i></div>
                        <h3 class="h5 fw-bold mb-3">@skill.Title</h3>
                        <p class="text-muted small mb-4">@skill.Description</p>

                        <!-- Seviye göstergesi (0-100) -->
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">Seviye</span>
                            <strong>%@skill.Level</strong>
                        </div>
                        <div class="progress" style="height: 8px;" role="progressbar" aria-valuenow="@skill.Level" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width: @(skill.Level)%; background-color: var(--accent-sage, #8aa593);"></div>
                        </div>
                    </div>
                </div>
            }
            @if (!Model.Any())
            {
                <p class="text-center text-muted">Henüz yetenek eklenmemiş.</p>
            }
        </div>
    </div>
</section>
