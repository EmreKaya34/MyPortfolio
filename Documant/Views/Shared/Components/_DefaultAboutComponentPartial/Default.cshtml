@model Documant.Entities.About?
@{
    string? image = !string.IsNullOrEmpty(Model?.ImageUrl) ? Model!.ImageUrl : (string?)ViewBag.FallbackImage;
}
<!-- 5. About Me Section -->
<section id="about" class="bg-white border-top border-bottom">
    <div class="container">
        @if (Model == null)
        {
            <p class="text-center text-muted mb-0">Hakkımda bilgisi henüz eklenmemiş.</p>
        }
        else
        {
            <div class="row align-items-center gy-5">
                <div class="col-lg-5 reveal-on-scroll">
                    <div class="about-img-wrap">
                        @if (!string.IsNullOrEmpty(image))
                        {
                            <img src="@image" alt="@Model.FullName portre" class="w-100" style="height: 540px; object-fit: cover; object-position: center top;">
                        }
                        else
                        {
                            <div class="w-100 d-flex align-items-center justify-content-center bg-light text-muted" style="height: 540px;">
                                <i class="bi bi-person-circle" style="font-size: 7rem;"></i>
                            </div>
                        }
                        <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
                            <span class="small text-muted font-heading">@Model.FullName, @Model.Location</span>
                            <span class="badge bg-secondary-subtle text-dark fw-medium">@Model.JobTitle</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                    <div class="eyebrow-badge">
                        <i class="bi bi-person-lines-fill"></i> BENİ TANIYIN
                    </div>
                    <h2 class="section-title">Teknolojiye Tutkuyla Bağlı Bir Yolculuk.</h2>
                    <div class="text-muted fs-5 mb-4 lh-base">
                        <p class="mb-3">@Model.Description1</p>
                        @if (!string.IsNullOrWhiteSpace(Model.Description2))
                        {
                            <p class="mb-4">@Model.Description2</p>
                        }
                    </div>

                    <div class="row g-4 pt-2 pb-4 border-top border-bottom mb-4">
                        <div class="col-4"><div class="stat-number">@Model.Stat1Value</div><div class="stat-label">@Model.Stat1Label</div></div>
                        <div class="col-4"><div class="stat-number">@Model.Stat2Value</div><div class="stat-label">@Model.Stat2Label</div></div>
                        <div class="col-4"><div class="stat-number">@Model.Stat3Value</div><div class="stat-label">@Model.Stat3Label</div></div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <a href="#projects" class="btn-sage"><i class="bi bi-folder-check"></i><span>Projelerimi İncele</span></a>
                        <a href="#contact" class="btn-secondary-custom"><span>Bana Ulaşın</span></a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
