@model Documant.Models.HeroViewModel
<!-- 4. Hero Section -->
<section id="home">
    <div class="container">
        <div class="row align-items-center gy-5">
            <!-- Left Column -->
            <div class="col-lg-7 reveal-on-scroll is-revealed">
                <div class="eyebrow-badge">
                    <i class="bi bi-emoji-smile-fill"></i> @Model.Greeting
                </div>

                <h1 class="hero-title">
                    @Model.Title
                </h1>

                <div class="typewriter-wrapper">
                    <span id="typewriterText"></span><span class="typing-cursor"></span>
                </div>

                <p class="hero-lead">
                    @Model.Description
                </p>

                <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                    <a href="#projects" class="btn-sage">
                        <span>Projelerimi Keşfet</span>
                        <i class="bi bi-arrow-down-right"></i>
                    </a>
                    <a href="#contact" class="btn-secondary-custom">
                        <span>Benimle İletişime Geç</span>
                        <i class="bi bi-chat-text"></i>
                    </a>
                </div>

                <!-- Social Links (Admin > Sosyal Medya) -->
                @if (Model.Socials.Any())
                {
                    <div class="d-flex align-items-center gap-2 pt-2">
                        <span class="text-muted small me-2 font-heading fw-semibold">Takip Et:</span>
                        @foreach (var social in Model.Socials)
                        {
                            <a href="@social.Url" target="_blank" rel="noopener noreferrer" class="social-pill" title="@social.Name">
                                <i class="@social.IconClass"></i>
                            </a>
                        }
                    </div>
                }
            </div>

            <!-- Right Column -->
            <div class="col-lg-5 reveal-on-scroll is-revealed">
                <div class="position-relative mx-auto" style="max-width: 440px;">
                    <div class="hero-portrait-frame">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Title" class="hero-portrait-img">
                        }
                        else
                        {
                            <div class="hero-portrait-img d-flex align-items-center justify-content-center bg-light text-muted" style="min-height: 420px;">
                                <i class="bi bi-person-circle" style="font-size: 6rem;"></i>
                            </div>
                        }
                    </div>

                    <!-- Floating Experience Badge -->
                    @if (!string.IsNullOrEmpty(Model.Stat1Value))
                    {
                    <div class="floating-badge floating-badge-bottom">
                        <div class="skill-icon-box mb-0" style="width: 42px; height: 42px; background: var(--accent-sage-soft); color: var(--accent-sage-dark);">
                            <i class="bi bi-award-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold font-heading fs-6">@Model.Stat1Value</div>
                            <div class="text-muted small">@Model.Stat1Label</div>
                        </div>
                    </div>

                                        }

                    <!-- Subtle Top Badge -->
                    @if (!string.IsNullOrEmpty(Model.Stat3Value))
                    {
                    <div class="floating-badge floating-badge-top d-none d-sm-flex">
                        <div class="skill-icon-box mb-0" style="width: 38px; height: 38px; background: var(--accent-terracotta-soft); color: var(--accent-terracotta);">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold font-heading small">@Model.Stat3Value</div>
                            <div class="text-muted" style="font-size: 0.72rem;">@Model.Stat3Label</div>
                        </div>
                    </div>
                    }
                </div>
            </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="text-center mt-5 pt-4">
            <a href="#about" class="scroll-indicator">
                <div class="scroll-mouse">
                    <div class="scroll-dot"></div>
                </div>
                <span>Aşağı Kaydır</span>
            </a>
        </div>
    </div>
</section>

<!-- Daktilo animasyonunun ifadeleri veritabanından gelir -->
<script>window.heroTitles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RotatingTitles));</script>
